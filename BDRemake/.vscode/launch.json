{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Frontend",
			"type": "chrome",
			"request": "launch",
			"url": "http://localhost:3001",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "npm: run dev",
			"sourceMaps": true,
			"resolveSourceMapLocations": ["${workspaceFolder}/**", "!**/node_modules/**"]
		}
	]
}
